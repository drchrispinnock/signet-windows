<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Signet.App</RootNamespace>
    <AssemblyName>Signet</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Signet.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged (no MSIX), like the unsandboxed Mac app: it must reach %USERPROFILE%\.signet. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Program.cs is the entry point: single instance and the signet:// scheme. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-arm64" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Signet.Core\Signet.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Mac app's artwork, used as it is (like the bridge bundle): never copied into this repo. -->
    <Content Include="..\..\upstream\Signet\Resources\Assets.xcassets\TezosToken.imageset\tezos-token-round.svg" Link="Assets\TezosToken.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\upstream\Signet\Resources\Assets.xcassets\EtherlinkLogo.imageset\etherlink-avatar.svg" Link="Assets\EtherlinkLogo.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\upstream\Signet\Resources\Assets.xcassets\ShieldLogo.imageset\shield.png" Link="Assets\ShieldLogo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
